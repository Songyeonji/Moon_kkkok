# ── 이 파일을 복사해서 `.env` 로 저장한 뒤 값을 채워주세요 ──

# 목업 모드: Apps Script 없이 브라우저 메모리로 동작(개발/미리보기용).
#   1 = 목업 모드 ON,  0 또는 삭제 = 실제 Apps Script API 사용
VITE_MOCK=1

# 실제 배포 시: Apps Script 웹앱 배포 후 받은 /exec URL 을 여기에 붙여넣기
#   예) https://script.google.com/macros/s/AKfyc...../exec
VITE_API_URL=https://script.google.com/macros/s/AKfycbz4oz1KjArKOUvTdprrSZPN6poqHTYPeYWm4paZ77RDWrupoYUns74HSqbrz3WfN2JS/exec